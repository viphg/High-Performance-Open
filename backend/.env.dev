# Development Environment Configuration for High-Performance
# This file is for development purposes only

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5433/high_performance_open_dev
SQLALCHEMY_ECHO=True

# JWT Configuration  
SECRET_KEY=dev-secret-key-for-intelligent-recommendations-only-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Configuration
REDIS_URL=redis://localhost:6380/0

# Email Configuration (Development - can use test email service)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-test-email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=dev@highperformance.com

# Application Configuration
APP_NAME=High-Performance-Dev
DEBUG=True
ENVIRONMENT=development

# CORS Configuration - Updated for Intelligent Recommendations Development
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Machine Learning Configuration (New for Intelligent Recommendations)
ML_MODEL_PATH=./ml_models
ML_TRAINING_DATA_PATH=./data/training
RECOMMENDATION_CACHE_TTL=3600

# Development Database (for testing ML features)
ML_DATABASE_URL=sqlite:///./ml_recommendations_dev.db

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=./logs/dev.log

# Feature Flags (for development)
ENABLE_INTELLIGENT_RECOMMENDATIONS=True
ENABLE_ML_FEATURES=True
ENABLE_ADVANCED_ANALYTICS=True
ENABLE_COLLABORATIVE_FILTERING=False  # Disabled until data is collected

# Performance Monitoring (Development)
ENABLE_PERFORMANCE_MONITORING=True
METRICS_COLLECTION_INTERVAL=300

# Security Configuration (Development)
ALLOW_TEST_USERS=True
TEST_USER_EMAIL=testuser@highperformance.com
TEST_USER_PASSWORD=test123