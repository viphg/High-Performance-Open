# ============================================
# 阿里云邮件推送配置模板
# 请根据你在阿里云控制台获得的信息填写
# ============================================

# 阿里云邮件推送 - SMTP服务器
SMTP_SERVER=smtpdm.aliyun.com

# 阿里云邮件推送 - SMTP端口（SSL加密）
SMTP_PORT=465

# 阿里云邮件推送 - SMTP用户名（完整的发信地址）
SMTP_USER=noreply@mail.yourdomain.com

# 阿里云邮件推送 - SMTP密码（你在控制台设置的密码）
SMTP_PASSWORD=你的SMTP密码

# 发件人显示邮箱（通常与SMTP_USER相同）
FROM_EMAIL=noreply@mail.yourdomain.com

# ============================================
# 配置完成后，重启后端服务：
# docker restart hp-backend-open
# ============================================
