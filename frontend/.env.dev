# Frontend Development Environment Configuration for High-Performance
# This file is for development purposes only

# API Configuration - Updated for Intelligent Recommendations Development
VITE_API_URL=http://localhost:8001/api

# Development Environment Variables
VITE_NODE_ENV=development
VITE_APP_NAME=High-Performance-Dev
VITE_APP_VERSION=1.1.0-dev

# Intelligent Recommendations Configuration
VITE_ENABLE_INTELLIGENT_RECOMMENDATIONS=true
VITE_ENABLE_ML_FEATURES=true
VITE_ENABLE_ADVANCED_ANALYTICS=true
VITE_ENABLE_A_B_TESTING=false

# API Configuration for Intelligent Recommendations
VITE_RECOMMENDATION_API_BASE_URL=http://localhost:8001/api/v1/recommendations
VITE_ML_API_BASE_URL=http://localhost:8001/api/v1/ml

# Feature Flags
VITE_FEATURE_RECOMMENDATIONS=true
VITE_FEATURE_COLLABORATIVE_FILTERING=false
VITE_FEATURE_VOICE_INPUT=false
VITE_FEATURE_NATURAL_LANGUAGE_PROCESSING=false

# Debug Configuration
VITE_DEBUG_MODE=true
VITE_ENABLE_CONSOLE_LOGGING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# UI Configuration
VITE_THEME=light
VITE_ENABLE_DARK_MODE=false
VITE_DEFAULT_LANGUAGE=zh-CN

# Development Tools
VITE_ENABLE_HOT_RELOAD=true
VITE_ENABLE_SOURCE_MAPS=true
VITE_ENABLE_ESLINT=true

# Testing Configuration
VITE_ENABLE_MOCK_DATA=false
VITE_TEST_MODE=false
VITE_MOCK_API_RESPONSES=false

# Analytics and Monitoring (Development)
VITE_ENABLE_ANALYTICS_TRACKING=false
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_TRACKING=true

# Security Configuration (Development)
VITE_ENABLE_SECURITY_HEADERS=false
VITE_ENABLE_CORS_DEBUG=true